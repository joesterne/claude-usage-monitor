# Claude Usage Monitor settings.
# Copy to .env (git-ignored) and change what you need. Every line is optional;
# the values below are the defaults. Real environment variables win over .env.

# Address the local server listens on. Keep 127.0.0.1 so only this machine can reach it.
USAGE_MONITOR_HOST=127.0.0.1
USAGE_MONITOR_PORT=8765

# SQLite database file. Leave unset for the default:
#   script: usage.db next to usage_monitor.py
#   Mac app: ~/Library/Application Support/Claude Usage Monitor/usage.db
# USAGE_MONITOR_DB=/path/to/usage.db

# Where the Claude Code hook sends usage.
# Defaults to http://HOST:PORT/usage from the two settings above.
# USAGE_MONITOR_URL=http://127.0.0.1:8765/usage

# Folder of Claude Code transcripts the app imports on launch.
# CLAUDE_PROJECTS_DIR=~/.claude/projects

# Set to 1 to log every HTTP request to the console.
USAGE_MONITOR_VERBOSE=
